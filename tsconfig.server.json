{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["server", "shared", "prisma/seed.ts", "vite.config.ts"]
}
